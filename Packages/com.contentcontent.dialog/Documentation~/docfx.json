{
  "metadata": [
    {
      "src": [
        {
          "src": "../Runtime",
          "files": [
            "**/*.cs"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "ContentContent Dialog System",
      "_appFooter": "ContentContent Dialog System API Reference",
      "_enableSearch": true
    }
  }
}